{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:allNonMajor"],
  "ignorePaths": [".github/workflows/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.cue$/", "!**/*.gen.cue"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "(_?images?):\\s*(\\w+:\\s*)?\"(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)\""
      ]
    },
    {
      "customType": "regex",
      "matchStringsStrategy": "recursive",
      "managerFilePatterns": ["/\\.cue$/", "!**/*.gen.cue"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "_?images?:\\s*\\{[^{}]*\\}",
        "(?:^|\\n)\\s*[\\w-]+:\\s*\"(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.cue$/", "!**/*.gen.cue"],
      "datasourceTemplate": "git-tags",
      "matchStrings": [
        "k: GitRepository:\\s*\"?[^\":\\n]+\"?:\\s*spec:\\s*\\{\\s*\\n\\s*url:\\s*\"(?<depName>[^\"\\n]+)\"\\s*\\n\\s*ref:\\s*tag:\\s*\"(?<currentValue>[^\"\\n]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.cue$/", "!**/*.gen.cue"],
      "datasourceTemplate": "helm",
      "matchStrings": [
        "k: HelmRepository:\\s*\"?[^\":\\n]+\"?:\\s*spec:\\s*url:\\s*\"(?<registryUrls>[^\"\\n]+)\"\\s*\\n\\s*k: HelmRelease:\\s*\"?[^\":\\n]+\"?:\\s*spec:\\s*\\{\\s*\\n\\s*chart: spec: \\{\\s*\\n\\s*chart:\\s*\"(?<depName>[^\"]+)\"\\s*\\n\\s*version:\\s*\"(?<currentValue>[^\"\\n@]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.cue$/", "!**/*.gen.cue"],
      "matchStrings": [
        "//\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)\\s*\\n\\s*_?images?:\\s*(\\w+:\\s*)?\"(?<currentValue>[^\"\\n]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/export.sh"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+) datasource=(?<datasource>\\S+)\\nVERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["**/export.sh"],
      "postUpgradeTasks": {
        "commands": ["{{{packageFileDir}}}/export.sh"],
        "fileFilters": ["{{{packageFileDir}}}/**"],
        "executionMode": "branch"
      }
    }
  ]
}
